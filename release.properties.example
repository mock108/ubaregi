# Future Google Play release settings. No live credentials belong in this file.
# Copy to release.properties only when preparing a public release.
# release.properties is ignored by Git. This template is not read by a build yet.
# The Android project will add the loader when the release workflow is implemented.
# applicationId and versions stay in the Android build configuration, not here.

developerName=Mockup
billingEnabled=false
billingProductId=developer_support

# Fill only with an email address intended for public support.
supportEmail=

# Fill after the privacy policy has been published and checked without login.
privacyPolicyUrl=

# Future upload key; use forward slashes in Windows paths.
storeFile=
storePassword=
keyAlias=
keyPassword=
